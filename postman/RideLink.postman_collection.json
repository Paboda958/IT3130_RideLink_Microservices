					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"wrongpassword\"\n}"
						},
						"url": {
							"raw": "{{account_url}}/api/v1/accounts/login",
							"host": ["{{account_url}}"],
							"path": ["api", "v1", "accounts", "login"]
						}
					}
				},
				{
					"name": "Negative 2: Invalid Ride Status Transition (400 Bad Request)",
					"request": {
						"method": "PATCH",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"IN_PROGRESS\"\n}"
						},
						"url": {
							"raw": "{{ride_url}}/api/v1/rides/{{ride_id}}/status",
							"host": ["{{ride_url}}"],
							"path": ["api", "v1", "rides", "{{ride_id}}", "status"]
						}
					}
				},
				{
					"name": "Negative 3: Simulated Payment Failure (402 Payment Required)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"rideId\": 999,\n  \"passengerId\": 1,\n  \"driverId\": 2,\n  \"amount\": 500.0,\n  \"distanceKm\": 3.0,\n  \"paymentMethod\": \"CREDIT_CARD\",\n  \"simulateFailure\": true\n}"
						},
						"url": {
							"raw": "{{payment_url}}/api/v1/payments/process",
							"host": ["{{payment_url}}"],
							"path": ["api", "v1", "payments", "process"]
						}
					}
				}
			]
		}
	]
